# These credentials are intentionally local-only and are safe to commit.
DJANGO_ENVIRONMENT=development
DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-development-only
ALLOWED_HOSTS=localhost,.localhost,127.0.0.1,[::1]
PLATFORM_ROOT_DOMAIN=localhost

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecommerce:ecommerce@postgres:5432/ecommerce
DATABASE_CONN_MAX_AGE=0

CORS_ALLOWED_ORIGINS=http://demo.localhost:3000,http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEXES=^http://(?:[a-z0-9]|[a-z0-9][a-z0-9-]*[a-z0-9])\.localhost:3000$
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=localhost
