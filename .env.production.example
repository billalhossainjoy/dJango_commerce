# Copy this file to .env.production and replace every placeholder.
# Never commit the real .env.production file.
DJANGO_ENVIRONMENT=production
DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.com
PLATFORM_ROOT_DOMAIN=example.com
JWT_PLATFORM_REFRESH_COOKIE_DOMAIN=.example.com

# Copy the connection string from Neon. Keep TLS and channel binding enabled.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require&channel_binding=require
DATABASE_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
CORS_ALLOWED_ORIGIN_REGEXES=^https://(?:[a-z0-9]|[a-z0-9][a-z0-9-]*[a-z0-9])\.example\.com$
CSRF_TRUSTED_ORIGINS=https://example.com,https://*.example.com
SECURE_HSTS_SECONDS=3600
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=example.com
NEXT_PUBLIC_PLATFORM_HOSTNAME=www.example.com

# Resend HTTPS delivery works on all Railway plans.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=replace-with-resend-api-key
# Optional alternative: EMAIL_TRANSPORT=smtp (Railway Pro or above).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=E-commerce <noreply@example.com>

# Cloudinary product-image uploads
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_PRESET=replace-with-signed-upload-preset

# Stripe platform subscriptions
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_ID=price_replace-me
STRIPE_TRIAL_DAYS=14
STRIPE_BILLING_ENFORCED=false
PLATFORM_FRONTEND_ORIGIN=https://example.com
