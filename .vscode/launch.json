{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: run server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "envFile": "${workspaceFolder}/.env.development",
      "justMyCode": true
    },
    {
      "name": "Django: current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "DJANGO_ENVIRONMENT": "test"
      },
      "envFile": "${workspaceFolder}/.env.test",
      "justMyCode": true
    }
  ]
}
